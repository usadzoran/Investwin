# Server-only variables for the optional Node worker/indexer. Never expose these through Vite or commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
POLYGON_DEPOSIT_MASTER_SEED=replace-with-a-dedicated-bip39-seed
POLYGON_NETWORK=mainnet
POLYGON_RPC_URL=https://polygon-rpc.example
POLYGON_TREASURY_ADDRESS=replace-with-public-treasury-address
POLYGON_USDT_ADDRESS=replace-with-official-network-token-address
POLYGON_SWEEP_ENABLED=false
POLYGON_INDEXER_ENABLED=false
POLYGON_INDEXER_CONFIRMATIONS=20
POLYGON_INDEXER_BLOCK_BATCH=1500
POLYGON_INDEXER_START_BLOCK=0
POLYGON_INDEXER_INTERVAL_MS=15000
PORT=3000
